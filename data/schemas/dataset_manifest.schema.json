{
  "$defs": {
    "ActualCounts": {
      "description": "Calculated actual counts across categories.",
      "properties": {
        "folklore_records": {
          "default": 0,
          "title": "Folklore Records",
          "type": "integer"
        },
        "total_records": {
          "default": 0,
          "title": "Total Records",
          "type": "integer"
        },
        "urban_legend_records": {
          "default": 0,
          "title": "Urban Legend Records",
          "type": "integer"
        }
      },
      "title": "ActualCounts",
      "type": "object"
    },
    "TargetBreakdown": {
      "description": "Target quotas breakdown across categories.",
      "properties": {
        "per_country_folklore": {
          "default": 10,
          "title": "Per Country Folklore",
          "type": "integer"
        },
        "per_country_urban_legends": {
          "default": 10,
          "title": "Per Country Urban Legends",
          "type": "integer"
        },
        "total_countries": {
          "default": 15,
          "title": "Total Countries",
          "type": "integer"
        }
      },
      "title": "TargetBreakdown",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Canonical manifest tracking dataset coverage, actual vs target counts, and rights status.",
  "properties": {
    "actual_country_count": {
      "default": 15,
      "description": "Number of configured country datasets",
      "title": "Actual Country Count",
      "type": "integer"
    },
    "actual_record_count": {
      "default": 0,
      "description": "Sum of actual published records",
      "minimum": 0,
      "title": "Actual Record Count",
      "type": "integer"
    },
    "country_list": {
      "description": "List of 15 target country codes",
      "items": {
        "type": "string"
      },
      "title": "Country List",
      "type": "array"
    },
    "coverage_gaps": {
      "description": "List of country/category pairs with 0 verified records",
      "items": {
        "type": "string"
      },
      "title": "Coverage Gaps",
      "type": "array"
    },
    "current_actual_counts": {
      "$ref": "#/$defs/ActualCounts"
    },
    "dataset_limitations": {
      "description": "Known dataset boundaries, rights warnings, and disclaimers",
      "items": {
        "type": "string"
      },
      "title": "Dataset Limitations",
      "type": "array"
    },
    "dataset_validation_status": {
      "default": "valid_empty_staging",
      "description": "Status flag of dataset integrity",
      "title": "Dataset Validation Status",
      "type": "string"
    },
    "dataset_version": {
      "default": "0.2.0",
      "description": "Semantic version of the dataset collection",
      "title": "Dataset Version",
      "type": "string"
    },
    "duplicate_findings_count": {
      "default": 0,
      "description": "Count of suspected duplicates requiring review",
      "title": "Duplicate Findings Count",
      "type": "integer"
    },
    "folklore_counts_by_country": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Count of folklore records per country",
      "title": "Folklore Counts By Country",
      "type": "object"
    },
    "generated_at": {
      "description": "ISO timestamp of manifest generation",
      "title": "Generated At",
      "type": "string"
    },
    "last_validation_timestamp": {
      "description": "ISO timestamp of last validation run (Phase 1 compatibility)",
      "title": "Last Validation Timestamp",
      "type": "string"
    },
    "metadata_only_records": {
      "default": 0,
      "description": "Count of metadata-only records",
      "title": "Metadata Only Records",
      "type": "integer"
    },
    "published_and_verified_records": {
      "default": 0,
      "description": "Count of records passing publication policy",
      "title": "Published And Verified Records",
      "type": "integer"
    },
    "records_by_content_origin": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Distribution of records by ContentOriginEnum",
      "title": "Records By Content Origin",
      "type": "object"
    },
    "records_by_language": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Distribution of records by primary language code",
      "title": "Records By Language",
      "type": "object"
    },
    "records_by_source": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Distribution of records by contributing source",
      "title": "Records By Source",
      "type": "object"
    },
    "rejected_records": {
      "default": 0,
      "description": "Count of records rejected during curation",
      "title": "Rejected Records",
      "type": "integer"
    },
    "required_record_count": {
      "default": 300,
      "description": "Target total verified record count",
      "title": "Required Record Count",
      "type": "integer"
    },
    "rights_pending_records": {
      "default": 0,
      "description": "Count of records awaiting rights review",
      "title": "Rights Pending Records",
      "type": "integer"
    },
    "schema_invalid_count": {
      "default": 0,
      "description": "Count of schema-invalid records found during scan",
      "title": "Schema Invalid Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "2.0.0",
      "description": "Dataset manifest schema contract version",
      "title": "Schema Version",
      "type": "string"
    },
    "source_coverage": {
      "description": "List of actively contributing sources",
      "items": {
        "type": "string"
      },
      "title": "Source Coverage",
      "type": "array"
    },
    "source_link_validation_findings": {
      "description": "Issues detected with source references or URLs",
      "items": {
        "type": "string"
      },
      "title": "Source Link Validation Findings",
      "type": "array"
    },
    "target_breakdown": {
      "$ref": "#/$defs/TargetBreakdown"
    },
    "target_country_count": {
      "default": 15,
      "description": "Number of target countries (15)",
      "title": "Target Country Count",
      "type": "integer"
    },
    "target_records_per_category": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Quotas per category",
      "title": "Target Records Per Category",
      "type": "object"
    },
    "total_target_records": {
      "default": 300,
      "description": "Target total verified record count (Phase 2)",
      "title": "Total Target Records",
      "type": "integer"
    },
    "unverified_candidates": {
      "default": 0,
      "description": "Count of unverified candidates in review pipeline",
      "title": "Unverified Candidates",
      "type": "integer"
    },
    "unverified_records": {
      "default": 0,
      "description": "Count of unverified records",
      "title": "Unverified Records",
      "type": "integer"
    },
    "urban_legend_counts_by_country": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Count of urban legend records per country",
      "title": "Urban Legend Counts By Country",
      "type": "object"
    }
  },
  "required": [
    "country_list",
    "folklore_counts_by_country",
    "urban_legend_counts_by_country"
  ],
  "title": "DatasetManifest",
  "type": "object"
}