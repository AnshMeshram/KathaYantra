# KathaYantra Frontend — Environment Configuration
# Copy this file to .env.local for local development.

# Backend API Configuration
# - On Vercel: Leave NEXT_PUBLIC_API_BASE_URL blank or omit it to use the built-in self-contained API.
# - With external FastAPI: Set to your deployed FastAPI backend URL (e.g. https://api.kathayantra.com).
# - Local development with uvicorn: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_PREFIX=/api/v1

# Application Identity
NEXT_PUBLIC_APP_NAME="KathaYantra — The Haunted Atlas"
NEXT_PUBLIC_APP_VERSION="0.3.0"
NEXT_PUBLIC_APP_TAGLINE="Preserve the story. Trace the source. Respect the culture. Keep the AI honest."

# Visual Assets & Map Settings
NEXT_PUBLIC_MAP_DEFAULT_CENTER="[20.5937, 78.9629]"
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=3
NEXT_PUBLIC_IMAGE_CDN_ENABLED=false
