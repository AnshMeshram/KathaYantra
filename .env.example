# KathaYantra - Environment Configuration Example
# Copy this file to .env for local runtime configuration.

# Application Settings
PROJECT_NAME="KathaYantra"
PROJECT_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
HOST="127.0.0.1"
PORT=8000
DEBUG=false
LOG_LEVEL="INFO"

# Allowed CORS Origins (JSON array of allowed origins for local development)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# Local AI Engine (Ollama + Gemma 2)
# KathaYantra uses a locally running Ollama instance; no paid cloud APIs or hosted LLMs.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma2"
OLLAMA_CONNECT_TIMEOUT=5.0
OLLAMA_READ_TIMEOUT=120.0
OLLAMA_MAX_RETRIES=2
OLLAMA_TIMEOUT_SECONDS=60.0

# Retrieval and Grounded AI Parameters
AI_MAX_INPUT_CHARS=1000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_CONTEXT_RECORDS=5
AI_MAX_CONTEXT_CHARS=6000
AI_TEMPERATURE=0.2
AI_FICTION_TEMPERATURE=0.7
AI_ENABLE_STORY_GENERATION=true
AI_ENABLE_CHAT_HISTORY=false
AI_RETRIEVAL_MIN_SCORE=0.5

# Optional External API Keys (Leave blank if not configured)
# Used for future Phase 2 integrations with rate-limited public APIs
EUROPEANA_API_KEY=""
JAPAN_SEARCH_API_KEY=""

# HTTP Client Settings for API connectors
KATHAYANTRA_USER_AGENT="KathaYantra/0.3.0 (https://github.com/AnshMeshram/KathaYantra; mailto:dev@rmsc.org)"
HTTP_TIMEOUT_SECONDS=30.0
HTTP_CONNECT_TIMEOUT=10.0
HTTP_READ_TIMEOUT=30.0
HTTP_MAX_RETRIES=3
HTTP_MAX_CONCURRENCY=5
HTTP_CACHE_TTL_SECONDS=86400

# Import Pipeline Controls
IMPORT_MAX_RESULTS=50
IMPORT_OUTPUT_DIR="data/processed/candidates"

# Filesystem Paths (Relative to project root)
DATA_DIR="data"
SEED_DIR="data/seed"
RAW_DIR="data/raw"
PROCESSED_DIR="data/processed"
MANIFESTS_DIR="data/manifests"

